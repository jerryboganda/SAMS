{
  "name": "sams-academy",
  "private": true,
  "version": "0.1.0",
  "description": "SAMS Academy — secure medical exam-prep LMS (video courses + QBank + mock exams + payments + admin panel).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c \"blue,green\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "cross-env NODE_ENV=production node server/src/index.js",
    "migrate": "npm run migrate --prefix server",
    "migrate:undo": "npm run migrate:undo --prefix server",
    "migrate:undo:all": "npm run migrate:undo:all --prefix server",
    "seed": "npm run seed --prefix server",
    "seed:undo": "npm run seed:undo --prefix server",
    "lint": "npm run lint --prefix server && npm run lint --prefix client",
    "test": "npm run test --prefix server && npm run test --prefix client",
    "verify": "npm run lint && npm run test && npm run build",
    "package": "echo \"TODO: Phase 14 deploy.zip builder\" && exit 1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3"
  }
}
