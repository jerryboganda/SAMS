# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build output
client/dist/
server/dist/
build/
coverage/

# Env
.env
.env.local
server/.env
server/.env.local
client/.env
client/.env.local
!.env.example
!client/.env.example
!server/.env.example

# Storage (never commit generated/uploaded content; keep folder structure via .gitkeep)
storage/uploads/*
storage/invoices/*
storage/backups/*
storage/logs/*
# storage/proofs/ (docs/07_EXECUTION_PLAN.md 9.5/9.6): payment-proof images —
# NOT statically served (server/src/app.js has no express.static mount for
# it, unlike storage/uploads/) since a proof image may contain real
# financial details; see services/manualPaymentService.js's own header.
storage/proofs/*
!storage/uploads/.gitkeep
!storage/invoices/.gitkeep
!storage/backups/.gitkeep
!storage/logs/.gitkeep
!storage/proofs/.gitkeep

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db

# Local tool state (Serena, etc.) — not part of the project deliverable
.serena/
